#!/bin/bash
# Sulinux testreszabás – a live-build a csomagok és az includes.chroot_after_packages
# bemásolása után futtatja, az élő rendszer chrootjában.
#
# A rendszer Debian marad a saját nevével és kinézetével (rendszerindító menü,
# bejelentkezőképernyő stb.); csak a telepítő viseli a Sulinux nevét. A Sulinux
# egyébként csak előre telepít és beállít; felismerni az /etc/sulinux-release fájlról lehet.
set -euo pipefail

. /etc/sulinux/build.conf

export DEBIAN_FRONTEND=noninteractive
export LC_ALL=C.UTF-8

log() { printf '\n>>> %s\n' "$*"; }

log "Flathub-alkalmazások"
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
# Csak magyar és angol fordítások (a *.Locale csomagok egyébként több GB-osak)
flatpak config --system --set languages "hu;en"
mapfile -t FLATPAKS < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' /usr/share/sulinux/flatpaks.list | grep -v '^$')
if [ "${#FLATPAKS[@]}" -gt 0 ]; then
    flatpak install --system -y --noninteractive flathub "${FLATPAKS[@]}"
fi

log "Fölösleges, csak ajánlásként behúzott csomagok eltávolítása (ISO-méret)"
# Noto *-extra: ritka írásrendszerek és betűváltozatok (~600 MB; a Noto alapfontok maradnak),
# Marvell Prestera: hálózati kapcsolók firmware-e, fortune: szöveges idézetgyűjtemény
FOLOSLEGES=(fonts-noto-extra fonts-noto-cjk-extra fonts-noto-ui-extra fonts-noto-unhinted
            firmware-marvell-prestera fortune-mod fortunes-debian-hints)
mapfile -t TOROLNI < <(dpkg-query -W -f '${db:Status-Status} ${Package}\n' "${FOLOSLEGES[@]}" 2>/dev/null \
                       | awk '$1 == "installed" { print $2 }')
if [ "${#TOROLNI[@]}" -gt 0 ]; then
    apt-get purge -y "${TOROLNI[@]}"
fi

log "Magyar nyelv, billentyűzet, időzóna (a telepített rendszer alapértéke is)"
[ -f /etc/locale.gen ] && sed -i -E 's/^# *(hu_HU.UTF-8 UTF-8)/\1/' /etc/locale.gen
locale-gen
update-locale LANG=hu_HU.UTF-8 LANGUAGE=hu:en
[ -f /etc/default/keyboard ] && sed -i -E 's/^XKBLAYOUT=.*/XKBLAYOUT="hu"/' /etc/default/keyboard
ln -sf /usr/share/zoneinfo/Europe/Budapest /etc/localtime
echo Europe/Budapest > /etc/timezone

# A telepítő (Calamares) alapértelmezett időzónája: /etc/calamares/modules/locale.conf

log "Takarékos KDE-alapbeállítások (minden felhasználónak, /etc/xdg)"
kw() { kwriteconfig6 --file "/etc/xdg/$1" --group "$2" --key "$3" "$4"; }
kw baloofilerc "Basic Settings" "Indexing-Enabled" false   # fájlindexelés ki
kw kwinrc Plugins blurEnabled false                        # elmosás ki
kw kwinrc Plugins contrastEnabled false                    # háttér-kontraszt effekt ki
kw kdeglobals KDE AnimationDurationFactor 0.5              # rövidebb animációk
kw kdeglobals Translations LANGUAGE hu:en
# A zárolóképernyőn is a Sulinux háttérkép látszódjon
kwriteconfig6 --file /etc/xdg/kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image \
    --group General --key Image "file:///usr/share/wallpapers/SulinuxTabla/"

log "Adatbázis- és webszerver ne induljon automatikusan (RAM-takarékosság)"
systemctl disable mariadb.service apache2.service || true

# A tovább nem terjeszthető programok (VS Code, PyCharm, Microsoft-fontok…) NEM kerülnek
# az ISO-ba: telepítés után a „sudo sulinux-addons” paranccsal tölthetők le.

log "Sulinux háttérképek (felirat és építési dátum)"
BR=/usr/share/sulinux/images
DATUM=$(date +%Y.%m.%d.)
for pair in SulinuxTabla:hatter-tabla SulinuxFuzet:hatter-fuzet; do
    dir=/usr/share/wallpapers/${pair%%:*}/contents
    install -d "$dir/images"   # a git üres mappát nem tárol, ezért itt hozzuk létre
    svg=$(mktemp --suffix=.svg)
    sed "s/@BUILD_DATE@/$DATUM/" "$BR/${pair#*:}.svg" > "$svg"
    for res in 1366x768 1920x1080 2560x1440 3840x2160; do
        rsvg-convert -w "${res%x*}" -h "${res#*x}" "$svg" -o "$dir/images/$res.png"
    done
    cp "$dir/images/1920x1080.png" "$dir/screenshot.png"
    rm -f "$svg"
done

log "Telepítő: a Sulinux nevével jelenjen meg"
# A telepítő a Debian Calamares-beállításait használja; csak a látható neveket írjuk át,
# a telepítés menete és a telepített rendszer (Debian) változatlan marad.
IKON=/usr/share/applications/calamares-install-debian.desktop
sed -i -e "s|^Name=.*|Name=${DISTRO_NAME} telepítése|" \
       -e "s|^GenericName=.*|GenericName=Rendszertelepítő|" \
       -e "s|^Comment=.*|Comment=A ${DISTRO_NAME} telepítése a gépre|" "$IKON"
# Az élő rendszer asztalára ezt a fájlt másolja ki a calamares-desktop-icon.desktop,
# így az asztali ikon felirata is ez lesz.

MARKA=/etc/calamares/branding/debian/branding.desc
sed -i -E -e "s|^( *productName: *).*|\1${DISTRO_NAME}|" \
          -e "s|^( *shortProductName: *).*|\1${DISTRO_NAME}|" \
          -e "s|^( *versionedName: *).*|\1${DISTRO_NAME} ${DISTRO_VERSION}|" \
          -e "s|^( *shortVersionedName: *).*|\1${DISTRO_NAME} ${DISTRO_VERSION}|" "$MARKA"

# A telepítés közben mutatott dia szövege
DIA=/etc/calamares/branding/debian/show.qml
sed -i -e "s|Welcome to Debian GNU/Linux\.<br/>|Üdvözöl a ${DISTRO_NAME}.<br/>|" \
       -e "s|The rest of the installation is automated and should complete in a few minutes\.|A telepítés innentől magától zajlik, néhány perc múlva kész.|" "$DIA"

log "Rendszermentés: egy mentés a telepítés után (első induláskor), a többi csak kézzel"
# Programtelepítéskor a snapper ne készítsen magától mentést.
echo 'DISABLE_APT_SNAPSHOT="yes"' >> /etc/default/snapper
# Időzítve és indításkor sem (a snapper csomag alapból mindkettőt bekapcsolja)
systemctl disable snapper-boot.timer snapper-timeline.timer
systemctl enable sulinux-snapshot-setup.service

log "Kiadásinformáció (ellenőrzés: cat /etc/sulinux-release)"
cat > /etc/sulinux-release <<EOF
NAME="${DISTRO_NAME}"
VERSION="${DISTRO_VERSION}"
BASE="Debian ${DISTRO_VERSION}"
BUILD_DATE="$(date -u +%Y-%m-%d)"
EOF
rm -f /etc/sulinux/build.conf
