#!/bin/bash
# Rendszermentés előkészítése a telepített gépen, első induláskor:
# snapper-beállítás automatikus mentések NÉLKÜL, majd egyetlen
# „Telepítés utáni állapot” mentés. További mentés csak kézzel készül
# (iskolinux-snapshot). Csak Btrfs gyökér-fájlrendszeren működik.
set -euo pipefail

[ "$(findmnt -no FSTYPE /)" = btrfs ] || { echo "A gyökér-fájlrendszer nem Btrfs, a rendszermentés nem érhető el."; exit 0; }

if [ ! -e /etc/snapper/configs/root ]; then
    snapper -c root create-config /
    # Nincs időzített mentés; a kézi mentésekből a legutóbbi 10 marad meg.
    snapper -c root set-config \
        TIMELINE_CREATE=no \
        NUMBER_CLEANUP=yes NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=10 \
        SPACE_LIMIT=0.3 FREE_LIMIT=0.2
    systemctl disable --now snapper-timeline.timer 2>/dev/null || true
    systemctl enable --now snapper-cleanup.timer
fi
# Indításonkénti mentés sincs (a snapper csomag alapból bekapcsolja)
systemctl disable --now snapper-boot.timer 2>/dev/null || true

if ! snapper -c root list --columns description 2>/dev/null | grep -q "Telepítés utáni állapot"; then
    # Takarítási szabály nélkül: ezt a mentést a rendszer soha nem törli magától.
    snapper -c root create --description "Telepítés utáni állapot" --userdata "important=yes"
fi
